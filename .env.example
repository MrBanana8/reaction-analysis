# Hume AI API key (required)
HUME_API_KEY=your_hume_api_key

# WebSocket server settings
WS_HOST=0.0.0.0
WS_PORT=8765

# Analyze every Nth frame (default: 1 = all frames, 5 = every 5th frame)
ANALYZE_EVERY_N_FRAMES=5

# Minimum seconds to upload analysis (default: 5)
MIN_SECONDS_TO_UPLOAD=5

# Supabase settings (optional - for saving results to database)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your_service_role_key
